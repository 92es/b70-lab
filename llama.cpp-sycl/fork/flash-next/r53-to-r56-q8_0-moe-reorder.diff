+// Q8_0 MoE experts: every expert slice becomes its own self-contained SoA (all quants, then all scales), exactly the
+// layout the dense Q8_0 reorder kernels read with k = ne00 * ne01 per slice. One-time, on the first decode.
+static bool reorder_qw_q8_0_moe(uint8_t * data_device, size_t expert_bytes, int64_t n_expert, int ncols, int nrows,
+                                dpct::queue_ptr stream) {
+    GGML_ASSERT(expert_bytes == (size_t) ncols * (size_t) nrows / QK8_0 * sizeof(block_q8_0));
+    for (int64_t e = 0; e < n_expert; ++e) {
+        if (!reorder_qw_q8_0(data_device + (size_t) e * expert_bytes, ncols, nrows, expert_bytes, 0, stream)) {
+            GGML_ASSERT(e == 0 && "Q8_0 MoE reorder failed part-way");
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool ggml_sycl_mmid_q8_0_reorder_ok(const ggml_tensor * src0) {
+    static const bool enabled = ggml_sycl_get_env("GGML_SYCL_MMID_Q8_0_REORDER", 1) != 0;
+    // the reorder kernels use 16-byte vector loads on the per-expert quant block
+    return enabled && src0->type == GGML_TYPE_Q8_0 && src0->ne[2] > 1 && src0->ne[3] == 1 &&
+           src0->ne[0] % QK8_0 == 0 && src0->nb[2] % 16 == 0 && (uintptr_t) src0->data % 16 == 0 &&
+           src0->nb[2] == (size_t) src0->ne[0] * src0->ne[1] / QK8_0 * sizeof(block_q8_0);
+}
